# Copy this file to .env for local development.
# Never add real values to this example file or commit backend/.env.

# AI/chatbot provider
OPENAI_API_KEY=

# Database connection
DATABASE_URL=

# SMS/notification provider
SMS_API_KEY=

# Maps provider. Restrict browser keys by domain when applicable.
MAPS_API_KEY=

# Comma-separated list of origins allowed to call the API, e.g.
# https://app.hindcare.example,https://admin.hindcare.example
# Leave as * only for local development. Set explicit origins before deploying.
ALLOWED_ORIGINS=*
