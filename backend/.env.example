# Copy this file to .env in the PROJECT ROOT (not inside backend/) —
# server.js loads .env from one level up from this file.
# Never add real values to this example file or commit the real .env.

# Runtime
NODE_ENV=development
PORT=4173
HOST=127.0.0.1

# Auth — REQUIRED before any real/production use.
# JWT_SECRET signs every login token. If this is left unset, the app
# generates a random one on each restart (fine for local dev — you'll just
# need to log in again after every restart) but will REFUSE TO START if
# NODE_ENV=production and this isn't set. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse a secret you've shared anywhere (chat, docs, git history, etc).
JWT_SECRET=

# Optional auth tuning — sensible defaults are used if left blank.
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
OTP_TTL_SEC=300
RESET_TOKEN_TTL_SEC=1800
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000

# AI/chatbot provider
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Database connection
DATABASE_URL=
# Set to false ONLY for local development against a TLS-less database.
# Production MUST keep this blank/true so certificates are verified.
DATABASE_SSL=

# Demo data. Leave unset in any deployed environment. When set to "true" on a
# non-production run, seeds shared-password demo accounts including a super
# admin. Never enable this on an internet-facing host.
ENABLE_DEMO_ACCOUNTS=

# Direct HTTPS termination in Node (optional). Point these at PEM files to
# serve HTTPS without a reverse proxy. If unset, the server speaks plain HTTP
# and you should terminate TLS at your proxy instead.
TLS_KEY_PATH=
TLS_CERT_PATH=
# Set to true when running behind a reverse proxy so x-forwarded-proto is
# trusted and plain-HTTP requests are redirected to HTTPS.
TRUST_PROXY=

# SMS/notification provider
SMS_API_KEY=

# Maps provider. Restrict browser keys by domain when applicable.
MAPS_API_KEY=

# Comma-separated list of origins allowed to call the API, e.g.
# https://app.hindcare.example,https://admin.hindcare.example
# Leave blank for the local app origin. Set explicit origins before deploying.
ALLOWED_ORIGINS=
